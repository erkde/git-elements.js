{
  "name": "@erkde/git-elements",
  "version": "0.2.0",
  "description": "Web components for presenting Git command output on the web.",
  "keywords": [
    "custom-elements",
    "diff",
    "git",
    "web-components"
  ],
  "homepage": "https://erkde.github.io/git-elements.js/",
  "bugs": {
    "url": "https://github.com/erkde/git-elements.js/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/erkde/git-elements.js.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/git-diff": {
      "types": "./dist/components/git-diff.d.ts",
      "import": "./dist/components/git-diff.js"
    },
    "./components/git-log": {
      "types": "./dist/components/git-log.d.ts",
      "import": "./dist/components/git-log.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "npm run format:check && tsup && tsc -p tsconfig.build.json",
    "build:demo": "vitepress build docs",
    "check-types": "tsc --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepublishOnly": "npm test && npm run build",
    "preview": "npm run build:demo && vitepress preview docs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.68.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^5.0.1"
  }
}
